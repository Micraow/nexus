{
  "name": "nexus-weave",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Micraow/nexus.git"
  },
  "homepage": "https://github.com/Micraow/nexus#readme",
  "bugs": {
    "url": "https://github.com/Micraow/nexus/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:appimage": "NO_STRIP=1 APPIMAGE_EXTRACT_AND_RUN=1 tauri build --bundles appimage",
    "build:extension": "node extension/build.mjs",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "d3": "^7.9.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.18.4",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.2.6",
    "sql.js": "^1.12.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/chrome": "^0.2.7",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.5",
    "vue-tsc": "^2.1.10"
  }
}
