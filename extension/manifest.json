{
  "manifest_version": 3,
  "name": "Nexus 织知导出",
  "version": "1.0.0",
  "description": "把 DeepSeek 网页端的历史会话导出为 Nexus 织知桌面版可导入的标准 JSON。",
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Nexus 织知导出工作台"
  },
  "options_page": "workbench.html",
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://chat.deepseek.com/*"]
}
